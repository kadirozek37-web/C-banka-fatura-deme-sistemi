// --- GLOBAL DEGISKENLER VE YAPILAR ---
char aktifKullanici[50]; 

typedef struct {
    char adSoyad[50];
    char kartNo[20];
    char cvv[4];
    char skt[8];
    char sifre[6]; 
    float bakiye;
} KartBilgisi;

// --- YARDIMCI FONKSIYONLAR ---
void temizle() {
    int c;
    while ((c = getchar()) != '\n' && c != EOF);
}

void sifreYildizliAl(char *sifre) {
    int i = 0;
    char ch;
    while (1) {
        ch = getch();
        if (ch == 13) { 
            sifre[i] = '\0';
            break;
        } 
        else if (ch == 8) { 
            if (i > 0) {
                i--;
                printf("\b \b");
            }
        } 
        else {
            sifre[i++] = ch;
            printf("*");
        }
    }
    printf("\n");
}

// --- DOSYA VE HESAP ISLEMLERI ---

void yeniHesapOlustur() {
    char user[50], pass[50];
    printf("\n--- KAYIT EKRANI ---\nKullanici Adi: "); scanf("%s", user);
    printf("Yeni Sifre Olustur: ");
    sifreYildizliAl(pass);
    
    // Klasör yolu eklendi: gunlukler/
    FILE *f = fopen("gunlukler/users.txt", "a");
    if(f) {
        fprintf(f, "%s %s\n", user, pass);
        fclose(f);
        printf("Hesap olusturuldu! Giris yapabilirsiniz.\n");
    } else {
        printf("[HATA] Kayit dosyasi olusturulamadi!\n");
    }
}

int girisYap() {
    char user[50], pass[50], fUser[50], fPass[50];
    printf("\n--- GIRIS EKRANI ---\nKullanici Adi: "); scanf("%s", user);
    printf("Sifre: ");
    sifreYildizliAl(pass);
    
    // Klasör yolu eklendi: gunlukler/
    FILE *f = fopen("gunlukler/users.txt", "r");
    if (!f) return 0;
    while (fscanf(f, "%s %s", fUser, fPass) != EOF) {
        if (strcmp(user, fUser) == 0 && strcmp(pass, fPass) == 0) {
            strcpy(aktifKullanici, user);
            fclose(f); return 1;
        }
    }
    fclose(f); return 0;
}

// --- KART SISTEMI FONKSIYONLARI ---
void bakiyeGuncelle(char *secilenKartNo, float dusulecekTutar) {
    char dosyaAdi[100];
    sprintf(dosyaAdi, "gunlukler/%s_kartlar.txt", aktifKullanici); // Yol güncellendi
    FILE *f = fopen(dosyaAdi, "r");
    if (!f) return;

    KartBilgisi kartlar[100];
    char satir[250];
    int sayac = 0;

    while (fgets(satir, sizeof(satir), f)) {
        satir[strcspn(satir, "\n")] = 0;
        sscanf(satir, "%[^|]|%[^|]|%[^|]|%[^|]|%[^|]|%f", 
               kartlar[sayac].adSoyad, kartlar[sayac].kartNo, kartlar[sayac].cvv, 
               kartlar[sayac].skt, kartlar[sayac].sifre, &kartlar[sayac].bakiye);

        if (strcmp(kartlar[sayac].kartNo, secilenKartNo) == 0) {
            kartlar[sayac].bakiye -= dusulecekTutar;
        }
        sayac++;
    }
    fclose(f);

    f = fopen(dosyaAdi, "w");
    int i;
    for (i = 0; i < sayac; i++) {
        fprintf(f, "%s|%s|%s|%s|%s|%.2f\n", 
                kartlar[i].adSoyad, kartlar[i].kartNo, kartlar[i].cvv, 
                kartlar[i].skt, kartlar[i].sifre, kartlar[i].bakiye);
    }
    fclose(f);
}

void kartEkle() {
    char dosyaAdi[100], hamNo[20], tempSkt[10];
    sprintf(dosyaAdi, "gunlukler/%s_kartlar.txt", aktifKullanici); // Yol güncellendi
    KartBilgisi k;
    
    printf("\n--- YENI KART EKLEME ---\n");
    temizle();

    printf("Kart Sahibi Ad Soyad: "); 
    fgets(k.adSoyad, 50, stdin);
    k.adSoyad[strcspn(k.adSoyad, "\n")] = 0;

    while(1) {
        printf("Kart No (16 Rakam): "); scanf("%s", hamNo);
        if(strlen(hamNo) == 16) {
            sprintf(k.kartNo, "%.4s %.4s %.4s %.4s", hamNo, hamNo+4, hamNo+8, hamNo+12);
            
            int numaraKullaniliyor = 0;
            FILE *fOku = fopen(dosyaAdi, "r");
            if (fOku) {
                char satir[250];
                while (fgets(satir, sizeof(satir), fOku)) {
                    KartBilgisi mevcut;
                    sscanf(satir, "%[^|]|%[^|]|", mevcut.adSoyad, mevcut.kartNo);
                    if (strcmp(mevcut.kartNo, k.kartNo) == 0) {
                        numaraKullaniliyor = 1; break;
                    }
                }
                fclose(fOku);
            }
            if (numaraKullaniliyor) {
                printf("[HATA] Bu kart numarasi zaten kullaniliyor!\n");
                continue;
            }
            break;
        }
        printf("[HATA] Kart numarasi 16 hane olmalidir!\n");
    }

    while(1) {
        printf("CVV (3 Hane): "); scanf("%s", k.cvv);
        if(strlen(k.cvv) == 3) break;
        printf("[HATA] CVV 3 hane olmalidir!\n");
    }

    while(1) {
        printf("Son Kullanim (AAYY): "); scanf("%s", tempSkt);
        int ay = (tempSkt[0]-'0')*10 + (tempSkt[1]-'0');
        if(strlen(tempSkt) == 4 && ay >= 1 && ay <= 12) {
            sprintf(k.skt, "%.2s/%.2s", tempSkt, tempSkt+2);
            break;
        }
        printf("[HATA] Gecersiz tarih!\n");
    }
    
    while(1) {
        printf("Kartiniz icin 4 haneli bir sifre belirleyin: ");
        sifreYildizliAl(k.sifre);
        if(strlen(k.sifre) == 4) break;
        printf("[HATA] Sifre 4 haneli olmalidir!\n");
    }

    k.bakiye = (rand() % 5001) + 6000;

    FILE *f = fopen(dosyaAdi, "a");
    if (f) {
        fprintf(f, "%s|%s|%s|%s|%s|%.2f\n", k.adSoyad, k.kartNo, k.cvv, k.skt, k.sifre, k.bakiye);
        fclose(f);
        printf("\n[TAMAM] Kart kaydedildi!\n");
    }
}

void kartlariListele() {
    char kDosya[100];
    sprintf(kDosya, "gunlukler/%s_kartlar.txt", aktifKullanici); // Yol güncellendi
    FILE *f = fopen(kDosya, "r");
    if(!f) { 
        printf("\nHenuz eklenmis bir kartiniz yok!\n"); 
        return; 
    }

    KartBilgisi k;
    char satir[250];
    printf("\n--- MEVCUT KARTLARINIZ ---\n");
    printf("-------------------------------------------------------------------------------\n");
    printf("%-15s | %-19s | %-3s | %-5s | %-10s\n", "AD SOYAD", "KART NUMARASI", "CVV", "SKT", "BAKIYE");
    printf("-------------------------------------------------------------------------------\n");

    while (fgets(satir, sizeof(satir), f)) {
        satir[strcspn(satir, "\n")] = 0;
        sscanf(satir, "%[^|]|%[^|]|%[^|]|%[^|]|%[^|]|%f", 
               k.adSoyad, k.kartNo, k.cvv, k.skt, k.sifre, &k.bakiye);

        printf("%-15s | %-19s | %-3s | %-5s | %.2f TL\n", 
               k.adSoyad, k.kartNo, k.cvv, k.skt, k.bakiye);
    }
    printf("-------------------------------------------------------------------------------\n");
    fclose(f);
}

// --- FATURA SISTEMI FONKSIYONLARI ---
void faturalariYukle(float faturalar[]) {
    char dosyaAdi[100];
    sprintf(dosyaAdi, "gunlukler/%s_faturalar.txt", aktifKullanici); // Yol güncellendi
    FILE *f = fopen(dosyaAdi, "r");
    if (!f) {
        f = fopen(dosyaAdi, "w");
        int i;
        for (i = 0; i < 4; i++) {
            faturalar[i] = (i == 3) ? (rand() % 301 + 200) : (rand() % 801 + 400);
            fprintf(f, "%.2f\n", faturalar[i]);
        }
        fclose(f);
    } else {
    	int i;
        for (i = 0; i < 4; i++) fscanf(f, "%f", &faturalar[i]);
        fclose(f);
    }
}

void faturaDosyaGuncelle(float faturalar[]) {
    char dosyaAdi[100];
    sprintf(dosyaAdi, "gunlukler/%s_faturalar.txt", aktifKullanici); // Yol güncellendi
    FILE *f = fopen(dosyaAdi, "w");
    int i;
    for (i = 0; i < 4; i++) fprintf(f, "%.2f\n", faturalar[i]);
    fclose(f);
}

void faturaOde() {
    float faturalar[4];
    faturalariYukle(faturalar);
    char *turler[] = {"Elektrik", "Su", "Dogalgaz", "Internet"};
    int fSecim, kSecim;

    printf("\n--- GUNCEL BORCLAR ---\n");
    int i;
    for (i = 0; i < 4; i++) {
        if (faturalar[i] > 0) printf("%d. %s: %.2f TL\n", i+1, turler[i], faturalar[i]);
        else printf("%d. %s: [ODENDI]\n", i+1, turler[i]);
    }
    printf("5. Geri Don\nSecim: "); scanf("%d", &fSecim);
    if (fSecim < 1 || fSecim > 4 || faturalar[fSecim-1] <= 0) return;

    char kDosya[100];
    sprintf(kDosya, "gunlukler/%s_kartlar.txt", aktifKullanici); // Yol güncellendi
    FILE *f = fopen(kDosya, "r");
    if(!f) { printf("Odeme icin kartiniz yok!\n"); return; }

    KartBilgisi kList[20];
    int kSayi = 0; char satir[250];
    printf("\n--- KART SECIN ---\n");
    while (fgets(satir, sizeof(satir), f)) {
        satir[strcspn(satir, "\n")] = 0;
        sscanf(satir, "%[^|]|%[^|]|%[^|]|%[^|]|%[^|]|%f", 
               kList[kSayi].adSoyad, kList[kSayi].kartNo, kList[kSayi].cvv, 
               kList[kSayi].skt, kList[kSayi].sifre, &kList[kSayi].bakiye);
        
        printf("%d. %s (Bakiye: %.2f TL)\n", kSayi+1, kList[kSayi].kartNo, kList[kSayi].bakiye);
        kSayi++;
    }
    fclose(f);
    printf("Secim: "); scanf("%d", &kSecim);

    if (kSecim > 0 && kSecim <= kSayi) {
        char girilenSifre[10];
        printf("\n%s sifresini girin: ", kList[kSecim-1].kartNo);
        sifreYildizliAl(girilenSifre);

        if (strcmp(kList[kSecim-1].sifre, girilenSifre) == 0) {
            if (kList[kSecim-1].bakiye >= faturalar[fSecim-1]) {
                bakiyeGuncelle(kList[kSecim-1].kartNo, faturalar[fSecim-1]);
                
                printf("\n[TAMAM] %.2f TL Tahsil Edildi.\n", faturalar[fSecim-1]);

                char oDosya[100]; 
                sprintf(oDosya, "gunlukler/%s_odemeler.txt", aktifKullanici); // Yol güncellendi
                FILE *of = fopen(oDosya, "a");
                if(of) {
                    fprintf(of, "%s odendi: %.2f TL\n", turler[fSecim-1], faturalar[fSecim-1]);
                    fclose(of);
                }

                faturalar[fSecim-1] = 0;
                faturaDosyaGuncelle(faturalar);
            } else {
                printf("\n[HATA] Yetersiz bakiye!\n");
            }
        } else {
            printf("\n[HATA] Kart sifresi yanlis!\n");
        }
    }
}

void faturalariYenile() {
    float mevcutFaturalar[4];
    char dosyaAdi[100];
    sprintf(dosyaAdi, "gunlukler/%s_faturalar.txt", aktifKullanici); // Yol güncellendi
    
    FILE *fOku = fopen(dosyaAdi, "r");
    if (!fOku) return;
    int i;
    for (i = 0; i < 4; i++) fscanf(fOku, "%f", &mevcutFaturalar[i]);
    fclose(fOku);

    int yenilenenSayisi = 0;
    for (i = 0; i < 4; i++) {
        if (mevcutFaturalar[i] <= 0) {
            mevcutFaturalar[i] = (i == 3) ? (rand() % 301 + 200) : (rand() % 801 + 400);
            yenilenenSayisi++;
        }
    }

    FILE *fYaz = fopen(dosyaAdi, "w");
    for (i = 0; i < 4; i++) fprintf(fYaz, "%.2f\n", mevcutFaturalar[i]);
    fclose(fYaz);

    if (yenilenenSayisi > 0) printf("\n[TAMAM] Faturalar yenilendi!\n");
}

// --- MENULER ---
void kartlarimMenu() {
    int secim;
    while(1) {
        kartlariListele();
        printf("\n1. Yeni Kart Ekle\n2. Geri\nSecim: ");
        if(scanf("%d", &secim) != 1) { temizle(); continue; }
        if(secim == 1) kartEkle();
        else break;
    }
}

void anaMenu() {
    int secim;
    while(1) {
        printf("\n--- ANA MENU (%s) ---\n", aktifKullanici);
        printf("1. Kartlarim\n2. Fatura Odeme\n3. Faturalari Yenile\n4. Cikis\nSecim: ");
        if(scanf("%d", &secim) != 1) { temizle(); continue; }
        
        if(secim == 1) kartlarimMenu();
        else if(secim == 2) faturaOde();
        else if(secim == 3) faturalariYenile();
        else if(secim == 4) break;
    }
}

int main() {
    setlocale(LC_ALL, "Turkish"); 
    srand(time(NULL));
    
    // Uygulama baslarken klasörü kontrol eder/olusturur
    _mkdir("gunlukler");
    
    int secim;
    while(1) {
        printf("\n=== BANKA SISTEMI ===\n1. Giris\n2. Kayit\n3. Kapat\nSecim: ");
        if(scanf("%d", &secim) != 1) { temizle(); continue; }
        if(secim == 1) { if(girisYap()) anaMenu(); else printf("Hatali giris!\n"); }
        else if(secim == 2) yeniHesapOlustur();
        else break;
    }
    return 0;
}
